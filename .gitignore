# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Env / secrets
.env

# Node
node_modules/
frontend/dist/

# Large / downloaded data (re-fetch with scripts in README)
backend/data/aizynth/
# Ignore the contents, not the directory — a file inside an ignored directory cannot be re-included with !
backend/data/ord/*
# Exception: the projections metadata has no dataset names. If this map is lost, there is nowhere to recover it from
!backend/data/ord/dataset_names.json
*.hdf5
*.onnx

# OS
.DS_Store

# Build output (published as an artifact, so not committed)
frontend/dist/

backend/data/uspto50k/
backend/data/nicolit/
backend/data/ord_flat.parquet
backend/data/ml/
# Archive of training runs. Duplicates the current model in data/ and grows with every run
backend/data/runs/

# model.pkl / calibrator.pkl / calibration.png / metrics.json are **committed** (~1MB combined).
# Training takes over 3 hours, so without them a fresh clone cannot show plausibility scores in the demo.
# Same reason ord_hits.json is committed. The pkl is sensitive to lightgbm/sklearn versions, but
# if it cannot be loaded, predict.py returns (None, None) and the UI shows — — the app still runs.

# Analogous-reaction index (112MB) — scripts/build_analog_index.py rebuilds it from ORD.
# The measured results (analog_validation.json) are small, so they are committed. Same reason as metrics.json.
backend/data/analogs/

# Backups left by the price import (git already has the previous values)
*.csv.bak

# Canonicalized ORD records (312MB) — scripts/build_ord_canon.py rebuilds them from ord_flat.parquet in 70 seconds
backend/data/ord_canon.parquet

# Model A training inputs (683MB: fingerprints, descriptors and condition sets for 757k reactions)
# scripts/build_transfer_dataset.py --stage rows / --stage pairs rebuilds them
backend/data/transfer/

# Logs from overnight jobs
backend/data/logs/

# Intermediate output of the deep search for the 5 demo targets (84MB: 58MB procedure text, 19MB AiZynth routes).
# scripts/build_deep_targets.py rebuilds it. The exception is demo_*.json below — the app serves
# them as-is from /routes, so without them the demo does not run on a fresh clone (same reason as model.pkl)
backend/data/deep/*
!backend/data/deep/demo_*.json
!backend/data/deep/holdout_molecules.txt

# Model B trained for interim checks (at 500 and 1000 candidates). The full training run at dawn writes
# route_ranker.pkl separately, so there is no reason to keep these
backend/data/route_ranker_early*

# Intermediate output of the demo rebuild (scripts/rebuild_deep_targets.sh moves it to data/deep/ and deletes it when done)
backend/data/deep_next/

# Records exported from licensed searches such as SciFinder. The license belongs to whoever ran the search,
# so they are not put in the repo (scripts/import_scifinder.py)
backend/data/scifinder/

# PubChem compound-name cache (chem/names.py refills it)
backend/data/pubchem_titles.json

# Presentation material (slides, demo script, screenshots) — kept locally, not part of the submission
demo_assets/

# Local agent and editor config, scratch notes, second-machine setup
CLAUDE.md
.claude/
IDEAS.md
scripts/WINDOWS_WORKER.md
scripts/worker_setup.sh
